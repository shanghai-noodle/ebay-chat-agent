# Cloudflare Worker Environment Secrets
# Set these using: npx wrangler secret put <NAME>

# Gemini API
GEMINI_API_KEY="your-gemini-api-key"

# eBay Sandbox Developer Credentials
EBAY_APP_ID="your-ebay-app-id"
EBAY_CERT_ID="your-ebay-cert-id"
EBAY_DEV_ID="your-ebay-dev-id"
EBAY_USER_TOKEN="your-ebay-sandbox-user-token"

# Optional: Default eBay Seller Business Policy IDs (auto-discovered if omitted)
# EBAY_FULFILLMENT_POLICY_ID="1234567890"
# EBAY_PAYMENT_POLICY_ID="1234567890"
# EBAY_RETURN_POLICY_ID="1234567890"

# Google Chat Service Account JSON (stringified single-line JSON)
# Used to authenticate attachment image downloads from Google Chat
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
